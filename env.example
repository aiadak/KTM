# Required — Claude API. Without this the agents cannot generate anything.
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Optional — live Atlassian pull, used ONLY when the user clicks
# "Connect to Jira / Confluence" inside the Archivist agent.
# Token: id.atlassian.com/manage-profile/security/api-tokens
JIRA_HOST=your-workspace.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_TOKEN=
JIRA_PROJECT_KEY=KAN
CONFLUENCE_SPACE_KEY=
